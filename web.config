<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <staticContent>
          <!--
            MỌI mimeMap phải có <remove> đứng trước nếu IIS ĐÃ CÓ SẴN đuôi đó.

            IIS coi fileExtension là KHOÁ DUY NHẤT: thêm một đuôi đã tồn tại (hoặc khai hai lần
            trong cùng file) là lỗi cấu hình 500.19 —
            "Cannot add duplicate collection entry of type 'mimeMap'..." — và nó làm CHẾT CẢ SITE,
            mọi URL trả 500 kể cả file không tồn tại (không phải 404). Đó đúng là sự cố 18/09:
            .js bị khai hai lần, lại còn thiếu <remove> cho .js/.webp/.wasm.
          -->
          <remove fileExtension=".manifest" />
          <remove fileExtension=".txt" />
          <remove fileExtension=".jsc" />
          <mimeMap fileExtension=".pem" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".plist" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".manifest" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".txt" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".jsc" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".pkm" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".pvr" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".astc" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".atlas" mimeType="application/octet-stream" />
          <mimeMap fileExtension=".pack" mimeType="application/octet-stream" />
          <remove fileExtension=".webp" />
          <mimeMap fileExtension=".webp" mimeType="image/webp" />
          <remove fileExtension=".js" />
          <mimeMap fileExtension=".js" mimeType="application/javascript" />
          <remove fileExtension=".wasm" />
          <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
          <clientCache cacheControlMode="DisableCache" />
        </staticContent>
        <httpProtocol>
            <customHeaders>
                <remove name="Cache-Control" />
                <add name="Cache-Control" value="no-cache" />
            </customHeaders>
        </httpProtocol>

         <!--
          Trang chia sẻ phim ngắn — đá URL đẹp về file tĩnh share-short/index.html.

          Link chia sẻ có dạng /share-short/<mã>?ep=2, mà trên đĩa KHÔNG có thư mục nào tên như vậy
          — IIS sẽ trả 404 tĩnh (đúng cái G63 gặp 16/09). Luật dưới đây đổi nó thành
          /share-short/index.html?code=<mã>&ep=2, rồi trang tự gọi API lấy dữ liệu.

          CHỈ cần module "URL Rewrite". KHÔNG cần ARR, vì đây là rewrite sang file NỘI BỘ chứ không
          proxy sang máy khác (G63 chốt 16/09 chọn phương án trang tĩnh gọi API).
        -->
        <rewrite>
            <rules>
                <!--
                  Đặt ĐẦU danh sách + stopProcessing: luật tĩnh/SPA đứng trước sẽ đá request về
                  index.html ở gốc site.

                  Điều kiện IsFile-phủ-định giữ cho chính share-short/index.html và mọi file thật
                  trong thư mục đó không bị viết lại — thiếu nó là trang tự đá vào chính nó.

                  appendQueryString mặc định là true nên ?ep=2 của link gốc tự nối vào sau
                  ?code=<mã>, ra index.html?code=<mã>&ep=2.
                -->
                <rule name="ShareShortStatic" stopProcessing="true">
                    <match url="^share-short/([^/]+)/?$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/share-short/index.html?code={R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
